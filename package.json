{
  "name": "tsmodel",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "sites/*"],
  "scripts": {
    "tsmodel": "bun packages/tsmodel/bin/tsmodel.ts",
    "build": "bun run --cwd packages/tsmodel build",
    "test": "bun run --cwd packages/tsmodel test && bun run --cwd packages/share test",
    "oracles": "bun run --cwd packages/tsmodel oracles",
    "bench": "bun run --cwd packages/tsmodel bench",
    "fuzz": "bun run --cwd packages/tsmodel fuzz",
    "typecheck": "bun run --cwd packages/tsmodel typecheck",
    "site:deploy": "bun run --cwd sites/tsmodel.leostera.dev deploy"
  },
  "devDependencies": { "@tsmodel/tsmodel": "workspace:*" }
}
